# Copy to .env and fill in. Never commit .env.
# None of these are needed for Phase 0 (Open-Meteo and dynamical.org are anonymous).

# Copernicus Climate Data Store (ERA5), optional: https://cds.climate.copernicus.eu/how-to-api
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# NASA Earthdata (IMERG via GES DISC), optional: IMERG is also on dynamical.org anonymously
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Override the data root (defaults to ./data)
TRUSTCAST_DATA_DIR=
